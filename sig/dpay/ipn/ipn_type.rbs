module DPay
  module IpnType
    TRANSFER: String
    # Deprecated: dpay no longer sends capture IPNs - use the payment.captured webhook event.
    CAPTURE: String
    DCB: String

    ALL: Array[String]

    def self.valid?: (untyped value) -> bool
    def self.assert_valid: (untyped value) -> void
  end
end
