module DPay
  class Failure
    attr_reader code: String
    attr_reader message: String?
    attr_reader category: String?
    attr_reader provider_code: String?
    attr_reader raw: Hash[String, untyped]

    @retryable: bool

    def self.from_api: (Hash[String, untyped] data) -> Failure

    def initialize: (Hash[String, untyped] data) -> void
    def retryable?: () -> bool
  end
end
