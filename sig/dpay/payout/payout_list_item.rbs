module DPay
  class PayoutListItem
    attr_reader id: Integer
    attr_reader type: String?
    attr_reader state: Integer
    attr_reader net: Money
    attr_reader fee: Money
    attr_reader gross: Money
    attr_reader currency: String
    attr_reader creation_date: String?
    attr_reader export_date: String?
    attr_reader raw: Hash[String, untyped]

    @declined: bool

    def self.from_api: (Hash[String, untyped] data) -> PayoutListItem

    def initialize: (Hash[String, untyped] data) -> void
    def waiting?: () -> bool
    def processed?: () -> bool
    def failed?: () -> bool
    def declined?: () -> bool

    private

    def integer: (untyped value) -> Integer
  end
end
