module DPay
  class PayoutPage
    attr_reader items: Array[PayoutListItem]
    attr_reader meta: PageMeta
    attr_reader raw: Hash[String, untyped]

    def self.from_api: (Hash[String, untyped] response) -> PayoutPage

    def initialize: (Hash[String, untyped] response) -> void
    def has_more?: () -> bool
  end
end
