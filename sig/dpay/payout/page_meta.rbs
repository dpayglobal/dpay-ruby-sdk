module DPay
  class PageMeta
    attr_reader page: Integer
    attr_reader per_page: Integer
    attr_reader total: Integer
    attr_reader total_pages: Integer

    def self.from_api: (Hash[String, untyped] data) -> PageMeta

    def initialize: (Hash[String, untyped] data) -> void
    def has_more?: () -> bool

    private

    def integer: (untyped value, Integer default) -> Integer
  end
end
