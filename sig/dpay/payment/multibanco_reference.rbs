module DPay
  class MultibancoReference
    attr_reader entity: String
    attr_reader reference: String
    attr_reader amount: Money?
    attr_reader currency: String
    attr_reader expires_at: String?
    attr_reader raw: Hash[String, untyped]

    def self.from_api: (Hash[String, untyped] data) -> MultibancoReference

    def initialize: (Hash[String, untyped] data) -> void

    private

    def string: (untyped value) -> String?
  end
end
