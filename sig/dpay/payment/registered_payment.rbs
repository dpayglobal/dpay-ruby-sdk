module DPay
  class RegisteredPayment
    REDIRECT: Regexp
    PAID: String
    INTERNAL_PROCESSING: String

    attr_reader transaction_id: String
    attr_reader message: String
    attr_reader ipksef: String?
    attr_reader raw: Hash[String, untyped]

    @currency: String

    def self.from_api: (Hash[String, untyped] data, ?String currency) -> RegisteredPayment

    def initialize: (Hash[String, untyped] data, ?String currency) -> void
    def redirect_url: () -> String?
    def paid?: () -> bool
    def internal_processing?: () -> bool
    def card_recurring_alias: () -> String?
    def recurring_alias: () -> String?
    def recurring_methods: () -> Array[String]
    def multibanco: () -> MultibancoReference?
    def paid_transaction: () -> RegisteredTransaction?

    private

    def recurring_registration: () -> Hash[String, untyped]
  end
end
